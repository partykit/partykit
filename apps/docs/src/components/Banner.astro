---
// Overrides Starlight's Banner to show the wind-down notice on every page.
// A page can still set its own `banner` in frontmatter to replace it.
import type { Props } from "@astrojs/starlight/props";

const { banner } = Astro.props.entry.data;
const isMigrationGuide = Astro.url.pathname.startsWith("/guides/migrate-to-partyserver");
---

{
  banner ? (
    <div class="sl-banner" set:html={banner.content} />
  ) : (
    <div class="sl-banner">
      <strong>The hosted PartyKit platform is shutting down.</strong>{" "}
      Deploys stop on 16 October and the platform shuts down on 23 October 2026.{" "}
      {isMigrationGuide ? (
        <a href="https://blog.partykit.io/posts/hosted-platform-shutdown/">Read the announcement →</a>
      ) : (
        <a href="/guides/migrate-to-partyserver/">Read the migration guide →</a>
      )}
    </div>
  )
}

<style>
  .sl-banner {
    padding: 0.6rem var(--sl-nav-pad-x);
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    border-bottom: 1px solid var(--sl-color-orange);
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }
  .sl-banner a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
